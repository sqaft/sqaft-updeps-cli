{
  "name": "@sqaft/updeps-cli",
  "version": "0.1.0",
  "description": "Bir paket push edildiğinde onu bağımlılık olarak kullanan repoları otomatik güncelleyen, dil ve paket yöneticisi bağımsız macOS CLI + arka plan servisi",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "updeps": "./bin/updeps.js",
