{
  "name": "@sqaft/updeps-cli",
  "version": "0.0.2",
  "description": "Automatically update the repos that depend on a package whenever it is pushed: a language- and package-manager-agnostic macOS CLI and launchd daemon.",
  "keywords": [
    "dependencies",
    "dependency-updates",
    "polyrepo",
    "multi-repo",
    "git",
    "push",
    "lockfile",
    "launchd",
    "macos",
    "cli",
    "automation",
    "npm",
    "composer"
  ],
  "homepage": "https://github.com/sqaft/sqaft-updeps-cli#readme",
  "bugs": {
    "url": "https://github.com/sqaft/sqaft-updeps-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqaft/sqaft-updeps-cli.git"
  },
  "author": "sqaft",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "updeps": "./bin/updeps.js",
    "sqaft-updeps": "./bin/updeps.js"
  },
  "files": [
    "bin/",
    "src/",
    "examples/"
  ],
  "scripts": {
    "test": "node --test --test-force-exit --import ./test/setup.js 'test/*.test.js'",
    "start": "node bin/updeps.js daemon",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
