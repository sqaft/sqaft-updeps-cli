{
  "notifications": true,
  "defaults": {
    "triggers": ["push"],
    "commands": ["npm update {pkgs} --no-audit --no-fund"],
    "commitMessage": "package updated {bumps}",
    "commandTimeout": 300,
    "debounceMs": 3000,
    "staleLockSec": 900,
    "push": false
  },
  "repos": [
    {
      "path": "~/workspace/acme/acme-api",
      "name": "@acme/api",
      "packages": [
        { "path": "~/workspace/acme/acme-app", "name": "acme-app" },
        { "path": "~/workspace/acme/acme-functions", "name": "acme-functions" },
        { "path": "~/workspace/acme/acme-runner", "name": "acme-runner" },
        { "path": "~/workspace/acme/acme-scheduler", "name": "acme-scheduler" }
      ]
    },
    {
      "path": "~/workspace/acme/acme-app",
      "name": "@acme/app",
      "packages": [
        { "path": "~/workspace/acme/acme-functions", "name": "acme-functions" },
        { "path": "~/workspace/acme/acme-runner", "name": "acme-runner" },
        { "path": "~/workspace/acme/acme-scheduler", "name": "acme-scheduler" }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-kit-sdk",
      "name": "@hooli/kit-sdk",
      "packages": [
        { "path": "~/workspace/acme/acme-app", "name": "acme-app" },
        { "path": "~/workspace/acme/acme-functions", "name": "acme-functions" },
        { "path": "~/workspace/acme/acme-runner", "name": "acme-runner" },
        { "path": "~/workspace/acme/acme-scheduler", "name": "acme-scheduler" }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-http-client",
      "name": "@hooli/http-client",
      "packages": [
        { "path": "~/workspace/hooli/hooli-kit-sdk", "name": "hooli-kit-sdk" },
        { "path": "~/workspace/acme/acme-app", "name": "acme-app" },
        { "path": "~/workspace/acme/acme-functions", "name": "acme-functions" },
        { "path": "~/workspace/acme/acme-runner", "name": "acme-runner" },
        { "path": "~/workspace/acme/acme-scheduler", "name": "acme-scheduler" }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-pipeline-runner",
      "name": "@hooli/pipeline-runner",
      "packages": [
        { "path": "~/workspace/acme/acme-runner", "name": "acme-runner" }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-queue-runner",
      "name": "@hooli/queue-runner",
      "packages": [
        { "path": "~/workspace/acme/acme-scheduler", "name": "acme-scheduler" }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-kit-core",
      "name": "@hooli/kit-core",
      "packages": [
        { "path": "~/workspace/hooli/hooli-kit-emails", "name": "hooli-kit-emails" },
        { "path": "~/workspace/hooli/hooli-kit-captchas", "name": "hooli-kit-captchas" },
        { "path": "~/workspace/hooli/hooli-kit-numbers", "name": "hooli-kit-numbers" }
      ]
    },
    {
      "path": "~/workspace/umbrella/umbrella-api",
      "name": "@umbrella/api",
      "packages": [
        { "path": "~/workspace/umbrella/umbrella-accounts", "name": "umbrella-accounts", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-functions", "name": "umbrella-functions", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-scout", "name": "umbrella-scout", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-machine", "name": "umbrella-machine", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-gateway", "name": "umbrella-gateway", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-runner", "name": "umbrella-runner", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-scheduler", "name": "umbrella-scheduler", "commands": ["yarn upgrade {pkgs}"] }
      ]
    },
    {
      "path": "~/workspace/umbrella/umbrella-mobile-client",
      "name": "@umbrella/mobile-client",
      "packages": [
        { "path": "~/workspace/umbrella/umbrella-accounts", "name": "umbrella-accounts", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-functions", "name": "umbrella-functions", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-scout", "name": "umbrella-scout", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-machine", "name": "umbrella-machine", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-gateway", "name": "umbrella-gateway", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-runner", "name": "umbrella-runner", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-scheduler", "name": "umbrella-scheduler", "commands": ["yarn upgrade {pkgs}"] }
      ]
    },
    {
      "path": "~/workspace/umbrella/umbrella-web-client",
      "name": "@umbrella/web-client",
      "packages": [
        { "path": "~/workspace/umbrella/umbrella-accounts", "name": "umbrella-accounts", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-functions", "name": "umbrella-functions", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-scout", "name": "umbrella-scout", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-machine", "name": "umbrella-machine", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-gateway", "name": "umbrella-gateway", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-runner", "name": "umbrella-runner", "commands": ["yarn upgrade {pkgs}"] },
        { "path": "~/workspace/umbrella/umbrella-scheduler", "name": "umbrella-scheduler", "commands": ["yarn upgrade {pkgs}"] }
      ]
    },
    {
      "path": "~/workspace/umbrella/umbrella-realtime",
      "name": "@umbrella/realtime",
      "packages": [
        { "path": "~/workspace/umbrella/umbrella-machine", "name": "umbrella-machine", "commands": ["yarn upgrade {pkgs}"] }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-sdk",
      "name": "hooli/sdk",
      "packages": [
        { "path": "~/workspace/hooli/hooli-web", "name": "hooli-web", "commands": ["composer update"] }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-notifications",
      "name": "hooli/notifications",
      "packages": [
        { "path": "~/workspace/hooli/hooli-web", "name": "hooli-web", "commands": ["composer update"] },
        { "path": "~/workspace/umbrella/umbrella-web", "name": "umbrella-web", "commands": ["composer update"] }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-subscriptions",
      "name": "hooli/subscriptions",
      "packages": [
        { "path": "~/workspace/hooli/hooli-web", "name": "hooli-web", "commands": ["composer update"] }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-auth",
      "name": "hooli/auth",
      "packages": [
        { "path": "~/workspace/hooli/hooli-web", "name": "hooli-web", "commands": ["composer update"] },
        { "path": "~/workspace/umbrella/umbrella-web", "name": "umbrella-web", "commands": ["composer update"] }
      ]
    },
    {
      "path": "~/workspace/hooli/hooli-billing",
      "name": "hooli/billing",
      "packages": [
        { "path": "~/workspace/hooli/hooli-web", "name": "hooli-web", "commands": ["composer update"] }
      ]
    }
  ]
}
